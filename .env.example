# Copy this file to .env and fill in the values you need.
# Everything here has a sane local-dev default except API keys.

# --- Database ---------------------------------------------------------------
# Postgres connection string. `docker compose up -d db` gives you one for free
# that matches this default.
DATABASE_URL="postgresql://jobfinder:jobfinder@localhost:5433/jobfinder?schema=public"

# --- Auth --------------------------------------------------------------------
# Any long random string. `openssl rand -hex 32` works well.
JWT_SECRET="change-me-to-a-long-random-string"

# --- LLM provider --------------------------------------------------------------
# "anthropic" or "openai". Used for CV parsing, match explanations, CV review
# and CV tailoring. See src/lib/llm.ts.
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Embeddings (optional) ------------------------------------------------------
# Used only as a cost-saving pre-filter: rank recent postings by similarity to
# the profile/CV before the LLM scores the shortlist. Anthropic has no
# embeddings endpoint, so this is entirely optional — leave OPENAI_API_KEY
# blank to run on Claude alone; matching then just scores the most recent
# postings directly instead of pre-ranking them.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"

# --- Email digest --------------------------------------------------------------
# Optional. Without a RESEND_API_KEY, digests are still generated and visible
# in-app, they just won't be emailed.
RESEND_API_KEY=""
EMAIL_FROM="AI Job Finder <jobs@yourdomain.com>"
APP_BASE_URL="http://localhost:3000"

# --- File storage --------------------------------------------------------------
# "local" writes uploaded CVs to disk under STORAGE_LOCAL_DIR (default: good
# enough for self-hosting). "s3" targets any S3-compatible bucket.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# --- Background jobs -----------------------------------------------------------
# Shared secret required on the /api/cron/* endpoints (Authorization: Bearer <value>).
# Only needed if you trigger ingestion/digests via HTTP cron instead of `npm run worker`.
CRON_SECRET="change-me-too"
