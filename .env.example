# Copy this file to .env and fill in the values you need.
# Everything here has a sane local-dev default except API keys.

# --- Database ---------------------------------------------------------------
# Postgres connection string. `docker compose up -d db` gives you one for free
# that matches this default.
DATABASE_URL="postgresql://jobfinder:jobfinder@localhost:5433/jobfinder?schema=public"
# Optional. Serverless Postgres providers (Neon, Supabase) give you a pooled
# DATABASE_URL for the app plus a direct/unpooled one — set that here so
# `prisma migrate deploy` doesn't hang on the advisory lock PgBouncer can't
# hold. Neon's Vercel integration sets this automatically. Leave blank for
# a plain local/Docker Postgres.
DATABASE_URL_UNPOOLED=""

# --- Auth --------------------------------------------------------------------
# Any long random string. `openssl rand -hex 32` works well.
JWT_SECRET="change-me-to-a-long-random-string"

# --- LLM provider --------------------------------------------------------------
# "anthropic" or "openai". Used for CV parsing, match explanations, CV review
# and CV tailoring. See src/lib/llm.ts.
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Embeddings (optional) ------------------------------------------------------
# Used only as a cost-saving pre-filter: rank recent postings by similarity to
# the profile/CV before the LLM scores the shortlist. Anthropic has no
# embeddings endpoint, so this is entirely optional — leave OPENAI_API_KEY
# blank to run on Claude alone; matching then just scores the most recent
# postings directly instead of pre-ranking them.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"

# --- Email digest --------------------------------------------------------------
# Optional. Without a RESEND_API_KEY, digests are still generated and visible
# in-app, they just won't be emailed.
RESEND_API_KEY=""
EMAIL_FROM="AI Job Finder <jobs@yourdomain.com>"
APP_BASE_URL="http://localhost:3000"

# --- File storage --------------------------------------------------------------
# "local" writes uploaded CVs to disk under STORAGE_LOCAL_DIR (self-hosting —
# fine as long as the filesystem persists, e.g. a Docker volume). "vercel-blob"
# is required on Vercel (serverless functions have no persistent disk): create
# a private Blob store (`vercel blob create-store <name> --access private`),
# which injects BLOB_READ_WRITE_TOKEN, then set STORAGE_DRIVER=vercel-blob
# explicitly as a Vercel env var too (it is not auto-detected).
# "s3" targets any S3-compatible bucket (not yet implemented, see BUILD_SPEC.md).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/uploads"
BLOB_READ_WRITE_TOKEN=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# --- Job sources -----------------------------------------------------------------
# Aggregator boards (Remotive, Arbeitnow, RemoteOK, Jobicy, Himalayas, Working
# Nomads) are always on. Company career pages hosted on Greenhouse, Lever or
# Ashby are pulled directly, one board per company. Leave these unset for the
# curated defaults (see src/agents/sources/companyBoards.ts), or list your own
# as comma-separated `slug` or `slug:Display Name` — the slug is the one in the
# company's board URL (boards.greenhouse.io/<slug>, jobs.lever.co/<slug>,
# jobs.ashbyhq.com/<slug>). Set to an empty string to disable a platform.
# GREENHOUSE_BOARDS="anthropic:Anthropic,adyen:Adyen"
# LEVER_BOARDS="palantir:Palantir"
# ASHBY_BOARDS="openai:OpenAI,cohere:Cohere"

# --- Background jobs -----------------------------------------------------------
# Shared secret required on the /api/cron/* endpoints (Authorization: Bearer <value>).
# Only needed if you trigger ingestion/digests via HTTP cron instead of `npm run worker`.
CRON_SECRET="change-me-too"
