// Prisma schema for the AI Job Finder
// See BUILD_SPEC.md for the full data-model rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  timezone     String   @default("UTC")
  digestHour   Int      @default(7) // local hour (0-23) the daily digest is sent
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profiles       SearchProfile[]
  cvs            Cv[]
  digests        DailyDigest[]
  progress       UserProgress?
  achievements   UserAchievement[]
  activityEvents ActivityEvent[]
  applications   Application[]
  searchHistory  SearchHistory[]

  @@map("users")
}

enum SearchHistoryKind {
  COMPANY_SEARCH // the company search box on the job feed / overview
  PROFILE_CHANGE // a saved search-profile change that re-scored the feed
}

// Archive of what the user searched for: company lookups and search-profile
// snapshots. One row per distinct search; repeating the same search bumps
// updatedAt instead of adding a duplicate (see src/lib/searchHistory.ts).
model SearchHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind   SearchHistoryKind
  label  String // human-readable one-liner shown in the archive card
  params Json // what to re-run: { companies: [...] } or a profile snapshot
  // For PROFILE_CHANGE: the matches the feed showed for that search at the
  // moment it was replaced (see src/lib/archivedResults.ts), so an old
  // search can be browsed after the live feed has moved on.
  results     Json?
  resultCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("search_history")
}

// ---------------------------------------------------------------------------
// Search profile — what the user is looking for
// ---------------------------------------------------------------------------

model SearchProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String  @default("Default search")
  isActive Boolean @default(true)

  targetRoles String[] // e.g. ["Senior Backend Engineer", "Staff Engineer"]
  locations   String[] // free-text regions/cities, e.g. ["Berlin", "Netherlands"]
  remotePref  RemotePreference @default(ANY)

  seniority      Seniority?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?    @default("USD")
  // Sales-style roles: the user expects commission / variable pay (OTE) on
  // top of base, so postings that offer it should score better.
  expectsCommission Boolean @default(false)
  industries     String[]
  languages      String[] // spoken/working languages required or preferred

  activeCvId String?
  activeCv   Cv?     @relation("ProfileActiveCv", fields: [activeCvId], references: [id])

  // Set while a scoring run for this search is in flight, so pages can say
  // "scoring" instead of "no matches" and a second run cannot start.
  scoringStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches       MatchScore[]
  digestEntries DailyDigestEntry[]

  @@index([userId])
  @@map("search_profiles")
}

enum RemotePreference {
  REMOTE
  HYBRID
  ON_SITE
  ANY
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
  PRINCIPAL
  MANAGER
  DIRECTOR
  EXECUTIVE
}

// ---------------------------------------------------------------------------
// CV — uploaded file + parsed structured content + review
// ---------------------------------------------------------------------------

model Cv {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName      String
  storageKey    String // key/path understood by the storage adapter (local disk or S3-compatible)
  mimeType      String
  fileSizeBytes Int

  rawText   String? // extracted plain text
  parsed    Json? // structured extraction: skills, roles, education, experience[], etc.
  embedding Float[] // vector embedding of the CV for similarity scoring (see BUILD_SPEC.md)

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews           CvReview[]
  tailoredVersions  TailoredCv[]
  activeForProfiles SearchProfile[] @relation("ProfileActiveCv")
  applications      Application[]

  @@index([userId])
  @@map("cvs")
}

// One CV can have many reviews over time — each re-review (re-upload, manual
// re-run) keeps its row so the CV-score trend on the analytics page has real
// history instead of only ever showing the latest score.
model CvReview {
  id   String @id @default(cuid())
  cvId String
  cv   Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  overallScore Int // 0-100
  verdict      CvVerdict
  summary      String

  strengths String[]
  issues    CvIssue[]

  atsCompatible Boolean
  atsNotes      String?

  createdAt DateTime @default(now())

  @@index([cvId, createdAt])
  @@map("cv_reviews")
}

enum CvVerdict {
  STRONG
  GOOD
  NEEDS_WORK
  WEAK
}

model CvIssue {
  id       String   @id @default(cuid())
  reviewId String
  review   CvReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  category    CvIssueCategory
  severity    IssueSeverity
  description String
  suggestion  String

  @@map("cv_issues")
}

enum CvIssueCategory {
  MISSING_KEYWORDS
  WEAK_BULLET
  STRUCTURE
  FORMATTING
  ATS_COMPATIBILITY
  QUANTIFICATION
  OTHER
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

// A CV tailored towards one specific job posting.
model TailoredCv {
  id           String     @id @default(cuid())
  cvId         String
  cv           Cv         @relation(fields: [cvId], references: [id], onDelete: Cascade)
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  suggestions   Json // ordered list of edits: {section, before, after, reason}
  rewrittenText String? // tailored professional summary
  // The complete tailored CV as structured sections (agents/cvTailor.ts
  // TailoredCvDocument), rendered to .docx/.txt on download. Every fact in
  // it is provenance-checked against the uploaded CV's text.
  document      Json?
  // The candidate's own uploaded .docx with the accepted changes applied in
  // place (lib/docxEdit.ts) — their layout, their file. Preferred attachment.
  editedStorageKey String?
  editReport       Json? // { applied: number[], notFound: number[], generatedAt }

  createdAt DateTime @default(now())

  applications Application[]

  @@unique([cvId, jobPostingId])
  @@map("tailored_cvs")
}

// ---------------------------------------------------------------------------
// Applications: one per user+posting. The app packages the chosen CV and a
// generated cover note; it sends by email when the posting exposes an
// address, otherwise records the application and hands the user to the
// company's own page (nothing can submit into third-party hiring forms).
// ---------------------------------------------------------------------------

enum ApplicationMethod {
  EMAIL // sent from the app with the CV attached, user's email as reply-to
  MANUAL // applied on the company site; recorded here
}

enum ApplicationStatus {
  DRAFT
  SENT
  APPLIED
}

model Application {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingId String
  jobPosting   JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  cvId         String?
  cv           Cv?         @relation(fields: [cvId], references: [id], onDelete: SetNull)
  tailoredCvId String?
  tailoredCv   TailoredCv? @relation(fields: [tailoredCvId], references: [id], onDelete: SetNull)

  subject          String
  coverNote        String
  method           ApplicationMethod?
  status           ApplicationStatus  @default(DRAFT)
  sentTo           String?
  sentAt           DateTime?
  attachedFileName String? // what was actually attached/handed over at send time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobPostingId])
  @@index([userId, status])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// Job sources + postings
// ---------------------------------------------------------------------------

model JobSource {
  id            String        @id @default(cuid())
  key           String        @unique // e.g. "remotive", "arbeitnow", "remoteok"
  name          String
  kind          JobSourceKind
  baseUrl       String
  enabled       Boolean       @default(true)
  lastFetchedAt DateTime?
  lastError     String?

  postings JobPosting[]

  @@map("job_sources")
}

enum JobSourceKind {
  PUBLIC_API
  RSS
  COMPANY_BOARD // Greenhouse/Lever style per-company job boards
}

model JobPosting {
  id         String    @id @default(cuid())
  sourceId   String
  source     JobSource @relation(fields: [sourceId], references: [id])
  externalId String // id/url from the source, used for de-duplication

  title          String
  company        String
  location       String?
  remoteType     RemotePreference @default(ANY)
  seniority      Seniority?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  industries     String[]
  description    String
  url            String
  applyEmail     String? // application address found in the posting text, if any (agents/ingest.ts)
  // Cached LLM digest of the description (agents/jobSummary.ts): one-liner,
  // responsibilities, must-haves, nice-to-haves, compensation, location.
  // Generated on first view, so the raw wall of text isn't the default.
  summary        Json?

  embedding Float[] // vector embedding of the normalized description
  postedAt  DateTime?
  fetchedAt DateTime  @default(now())

  matches      MatchScore[]
  tailoredCvs  TailoredCv[]
  applications Application[]

  @@unique([sourceId, externalId])
  @@index([postedAt])
  @@map("job_postings")
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

model MatchScore {
  id           String        @id @default(cuid())
  profileId    String
  profile      SearchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPostingId String
  jobPosting   JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  score          Int // 0-100
  explanation    String // short human-readable rationale
  matchedSkills  String[]
  missingSkills  String[]
  isWildcard     Boolean  @default(false)
  wildcardReason String?
  // The posting names a place outside the profile's locations while the
  // candidate needs on-site/hybrid work; scored with a penalty and labelled.
  locationMismatch Boolean @default(false)

  viewedAt  DateTime? // first time the user opened this job's detail page
  appliedAt DateTime? // set when the user marks this job as applied

  createdAt DateTime @default(now())

  digestEntry DailyDigestEntry?

  @@unique([profileId, jobPostingId])
  @@index([profileId, score])
  @@map("match_scores")
}

// ---------------------------------------------------------------------------
// Daily digest
// ---------------------------------------------------------------------------

model DailyDigest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  digestDate DateTime // date-only, one digest per user per day
  sentAt     DateTime?
  channel    DigestChannel @default(EMAIL)

  entries DailyDigestEntry[]

  createdAt DateTime @default(now())

  @@unique([userId, digestDate])
  @@map("daily_digests")
}

enum DigestChannel {
  EMAIL
  IN_APP
}

model DailyDigestEntry {
  id           String        @id @default(cuid())
  digestId     String
  digest       DailyDigest   @relation(fields: [digestId], references: [id], onDelete: Cascade)
  profileId    String
  profile      SearchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  matchScoreId String        @unique
  matchScore   MatchScore    @relation(fields: [matchScoreId], references: [id], onDelete: Cascade)

  rank Int // position within the digest (best match first)

  @@map("daily_digest_entries")
}

// ---------------------------------------------------------------------------
// Gamification + activity log (also the source data for the analytics page)
// ---------------------------------------------------------------------------

model UserProgress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  points        Int       @default(0)
  level         Int       @default(1)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveOn  DateTime? // date-only; used to compute streak continuation

  updatedAt DateTime @updatedAt

  @@map("user_progress")
}

// Static catalog of unlockable achievements — seeded once, referenced by key.
model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  icon        String // short emoji glyph
  points      Int    @default(0)
  sortOrder   Int    @default(0)

  unlockedBy UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  unlockedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

enum ActivityType {
  PROFILE_CREATED
  CV_UPLOADED
  CV_REVIEWED
  CV_TAILORED
  JOB_VIEWED
  JOB_APPLIED
  DAILY_VISIT
}

// Every point-earning action, in order. Powers both the gamification engine
// (points/streak/achievement checks all read from this) and the analytics
// page's activity history — one log, two views.
model ActivityEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     ActivityType
  points   Int          @default(0)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("activity_events")
}
